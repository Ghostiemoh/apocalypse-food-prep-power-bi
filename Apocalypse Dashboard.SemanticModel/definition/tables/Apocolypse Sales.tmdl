				    }
				  ]
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"a","Entity":"Apocolypse Sales"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"a"}},"Property":"Customer"}}],"GroupItems":[{"DisplayName":"(Blank)","BlankDefaultPlaceholder":true},{"DisplayName":"Best Client","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"a"}},"Property":"Customer"}}],"Values":[[{"Literal":{"Value":"'Alex The Analyst Apocolype Preppers'"}}],[{"Literal":{"Value":"'Apocolypse Preppers United'"}}]]}}},{"DisplayName":"Worst Clients","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"a"}},"Property":"Customer"}}],"Values":[[{"Literal":{"Value":"'Prep4Anything Prepping Store'"}}],[{"Literal":{"Value":"'Uncle Joe''s Prep Shop'"}}]]}}}]}

