	column 'Customer (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('Apocolypse Sales'[Customer]),
				"(Blank)",
				'Apocolypse Sales'[Customer] IN {"Alex The Analyst Apocolype Preppers",
					"Apocolypse Preppers United"},
				"Best Client",
				'Apocolypse Sales'[Customer] IN {"Prep4Anything Prepping Store",
					"Uncle Joe's Prep Shop"},
				"Worst Clients",
				'Apocolypse Sales'[Customer]
			)
		lineageTag: ae7f3ee3-31d5-4cfc-ac5c-a5887a44791b
		summarizeBy: none

