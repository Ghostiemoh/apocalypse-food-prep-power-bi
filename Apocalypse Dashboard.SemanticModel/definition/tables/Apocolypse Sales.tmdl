	column 'Date Purchased (bins)' =
			IF(
				ISBLANK('Apocolypse Sales'[Date Purchased]),
				BLANK(),
				DATE(
					YEAR('Apocolypse Sales'[Date Purchased]),
					1 + (MONTH('Apocolypse Sales'[Date Purchased]) - 1),
					1
				)
			)
		formatString: mmmm yyyy
